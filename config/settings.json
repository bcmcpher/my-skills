{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(rtk git status)",
      "Bash(git log *)",
      "Bash(rtk git log *)",
      "Bash(git diff *)",
      "Bash(rtk git diff *)",
      "Bash(git branch *)",
      "Bash(rtk git branch *)",
      "Bash(git stash *)",
      "Bash(rtk git stash *)",
      "Bash(git worktree *)",
      "Bash(rtk git worktree *)",
      "Bash(git fetch *)",
      "Bash(rtk git fetch *)",
      "Bash(git merge-base *)",
      "Bash(which *)",
      "Bash(find *)",
      "Bash(rtk find *)",
      "Bash(ls *)",
      "Bash(rtk ls *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(gh api:*)",
      "Bash(rtk gh api:*)",
      "Read",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.datalad.org)",
      "WebFetch(domain:handbook.datalad.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:nipoppy.readthedocs.io)",
      "WebFetch(domain:bids-specification.readthedocs.io)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -f *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(ssh * | bash)",
      "Bash(scp * | bash)",
      "Bash(apt *)",
      "Bash(sudo *)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.gnupg/*)",
      "Edit(~/.ssh/*)",
      "Edit(~/.aws/*)",
      "Edit(~/.gnupg/*)",
      "Read(**/.git/*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/secrets/**)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(rtk git add *)",
      "Bash(git commit *)",
      "Bash(rtk git commit *)",
      "Bash(git push *)",
      "Bash(rtk git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(rtk git checkout *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git branch -D *)",
      "Bash(rtk git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(rtk git branch -d *)",
      "Bash(git stash drop *)",
      "Bash(rtk git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(rtk git stash clear *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(rtk pip install *)",
      "Bash(pip uninstall *)",
      "Write",
      "Edit"
    ],
    "defaultMode": "plan"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-lsp-tools/bin/code-review-graph update --skip-flows -q",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-lsp-tools/bin/code-review-graph status || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-lsp-tools/bin/code-review-graph update -q || true",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "skill-creator@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/JuliusBrussee/caveman.git"
      }
    },
    "science-superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "K-Dense-AI/science-superpowers"
      }
    },
    "scientific-agents": {
      "source": {
        "source": "github",
        "repo": "K-Dense-AI/scientific-agents"
      }
    },
    "claude-scientific-writer": {
      "source": {
        "source": "github",
        "repo": "K-Dense-AI/claude-scientific-writer"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "timeFormat": "24-hour-utc",
  "theme": "dark",
  "verbose": true,
  "autoContinueAtUsageLimit": false,
  "remoteControlAtStartup": false,
  "disableBypassPermissionsMode": "disable"
}

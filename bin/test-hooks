#!/usr/bin/env bash
# test-hooks — exercise the PreToolUse hooks against a table of known cases.
#
# Usage:
#   bin/test-hooks [--repo] [--sandbox]
#
#   (default)   Test the live hooks in ~/.claude/hooks/
#   --repo      Test the tracked copies in config/hooks/
#   --sandbox   Re-run inside a read-only bwrap sandbox: the whole filesystem
#               read-only, $HOME an empty tmpfs, no network. Exits 1 if bwrap
#               is missing; it never falls back to running unsandboxed.
#
# Run this after touching a hook, and add a case for every rule you change --
# one command it must block, one similar command it must let through. Both
# regressions these hooks have had were false POSITIVES on the allow side:
#
#   * git-guard.sh matched ".git/" anywhere in the command text, blocking the
#     ordinary idiom `find . -not -path "./.git/*"`. It was deleted.
#   * bash-guard.sh matched redirection operators inside quoted strings, so
#     `git commit -m "docs: echo x >> ~/.bashrc is blocked"` was blocked --
#     a false positive that fires exactly when writing about the rules.
#
# Cases live in data files rather than inline in this script, because a heredoc
# of commands like `find . -delete` is itself caught by the hook under test:
#
#   tests/bash-guard-cases.txt     <expected-rc><TAB><command>
#   tests/protect-files-cases.txt  <expected-rc><TAB><field><TAB><path>
#
# No case is ever executed. Each one is passed through `jq --arg` to the hook's
# stdin, and the hooks only pattern-match their input. --sandbox is the second
# line of defence: even an accidental evaluation could not write anything.
#
# Exit codes from a PreToolUse hook: 0 allows, 2 blocks.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CASES="$REPO_ROOT/tests/bash-guard-cases.txt"
PCASES="$REPO_ROOT/tests/protect-files-cases.txt"

usage() { echo "Usage: $(basename "$0") [--repo] [--sandbox]" >&2; exit 1; }

HOOK_DIR="$HOME/.claude/hooks"; sandbox=0; args=()
for a in "$@"; do
  case "$a" in
    --repo)    HOOK_DIR="$REPO_ROOT/config/hooks"; args+=("$a") ;;
    --sandbox) sandbox=1 ;;
    *) usage ;;
  esac
done

if [[ $sandbox -eq 1 && -z "${TEST_HOOKS_SANDBOXED:-}" ]]; then
  command -v bwrap >/dev/null 2>&1 \
    || { echo "--sandbox needs bwrap, which is not on PATH; refusing to run unsandboxed" >&2; exit 1; }
  binds=(--ro-bind "$REPO_ROOT" "$REPO_ROOT")
  [[ -d "$HOME/.claude/hooks" ]] && binds+=(--ro-bind "$HOME/.claude/hooks" "$HOME/.claude/hooks")
  exec bwrap --ro-bind / / --tmpfs "$HOME" "${binds[@]}" \
    --tmpfs /tmp --dev /dev --proc /proc \
    --unshare-all --die-with-parent \
    --setenv HOME "$HOME" --setenv TEST_HOOKS_SANDBOXED 1 \
    "$REPO_ROOT/bin/test-hooks" "${args[@]}"
fi
[[ -n "${TEST_HOOKS_SANDBOXED:-}" ]] && echo "(sandboxed: read-only root, empty \$HOME, no network)"

command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }
[[ -f "$CASES" ]]  || { echo "missing case file: $CASES" >&2; exit 1; }
[[ -f "$PCASES" ]] || { echo "missing case file: $PCASES" >&2; exit 1; }

pass=0; fail=0
G=$'\033[32m'; R=$'\033[31m'; N=$'\033[0m'

report() { # report <ok?> <want> <got> <label>
  if [[ "$2" == "$3" ]]; then
    pass=$((pass + 1))
  else
    printf '  %sFAIL%s want=%s got=%s  %s\n' "$R" "$N" "$2" "$3" "$4"
    fail=$((fail + 1))
  fi
}

# ------------------------------------------------------------- bash-guard.sh
GUARD="$HOOK_DIR/bash-guard.sh"
if [[ -f "$GUARD" ]]; then
  while IFS=$'\t' read -r want cmd; do
    [[ -z "${want:-}" || "$want" == \#* ]] && continue
    got=$(jq -cn --arg c "$cmd" '{tool_input:{command:$c}}' \
            | bash "$GUARD" >/dev/null 2>&1; echo $?)
    report "" "$want" "$got" "$cmd"
  done < "$CASES"
else
  echo "  ${R}FAIL${N} bash-guard.sh not found at $GUARD"; fail=$((fail + 1))
fi

# ---------------------------------------------------------- protect-files.sh
PROTECT="$HOOK_DIR/protect-files.sh"
if [[ -f "$PROTECT" ]]; then
  while IFS=$'\t' read -r want field path; do
    [[ -z "${want:-}" || "$want" == \#* ]] && continue
    got=$(jq -cn --arg f "$field" --arg p "$path" '{tool_input:{($f):$p}}' \
            | bash "$PROTECT" >/dev/null 2>&1; echo $?)
    report "" "$want" "$got" "protect-files $field=$path"
  done < "$PCASES"
else
  echo "  ${R}FAIL${N} protect-files.sh not found at $PROTECT"; fail=$((fail + 1))
fi

# ------------------------------------------------------------ graph-update.sh
# The gate must stay silent outside a repo and in a repo with no graph, and
# must never propagate a non-zero exit into the hook.
GRAPH="$HOOK_DIR/graph-update.sh"
if [[ -f "$GRAPH" ]]; then
  out=$( (cd /tmp && bash "$GRAPH" status) 2>&1 ); rc=$?
  report "" 0 "$rc" "graph gate: exits 0 outside a repo"
  report "" "" "$out" "graph gate: silent outside a repo"
else
  echo "  ${R}FAIL${N} graph-update.sh not found at $GRAPH"; fail=$((fail + 1))
fi

if [[ $fail -eq 0 ]]; then
  printf '%s%s passed%s\n' "$G" "$pass" "$N"
else
  printf '%s%s passed, %s failed%s\n' "$R" "$pass" "$fail" "$N"
fi
exit $((fail > 0))
